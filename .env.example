# ── OCR gambar ─────────────────────────────────────────────
# tesseract (default, di perangkat) | mock | api
NEXT_PUBLIC_OCR_PROVIDER=tesseract
# Untuk provider "api": endpoint yang menerima multipart (field "image") dan membalas { text, confidence? }
NEXT_PUBLIC_OCR_API_URL=

# ── Voice note (speech-to-text) ───────────────────────────
# whisper (default, di perangkat) | api | mock
NEXT_PUBLIC_TRANSCRIBE_PROVIDER=whisper
# Model Whisper ONNX untuk Transformers.js (multibahasa). Contoh lain: onnx-community/whisper-small
NEXT_PUBLIC_WHISPER_MODEL=onnx-community/whisper-base
# Opsional: host model sendiri (mirror Hugging Face). Kosong = https://huggingface.co/
NEXT_PUBLIC_WHISPER_MODEL_HOST=

# Hanya untuk provider "api" (rahasia, khusus server — jangan diberi prefix NEXT_PUBLIC_)
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_RATE_LIMIT=30
